  {
    "description": "Replace an Issue's title and/or body. Pass the version you read: if the Issue changed since, the edit is refused with the current text instead of overwriting it.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "body": {
          "description": "The new Markdown body, replacing the old one",
          "type": [
            "null",
            "string"
          ]
        },
        "project": {
          "description": "The Slug of the Project to act on; defaults to the Project containing your working directory",
          "type": "string"
        },
        "ref": {
          "description": "The Issue: #N, N, slug#N or its URL",
          "type": "string"
        },
        "session": {
          "description": "Your Session id, for direct-HTTP clients; the X-Loom-Session header wins",
          "type": "string"
        },
        "title": {
          "description": "The new title",
          "type": [
            "null",
            "string"
          ]
        },
        "version": {
          "description": "The version you last read; the edit is refused if the Issue has changed since",
          "type": "integer"
