  {
    "description": "Block an Issue on others in the same Project. Blockers it already has are ignored; self-blocks and cycles are rejected, and then nothing changes.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "blocked_by": {
          "description": "Refs of the Blockers, in the same Project",
          "items": {
            "type": "string"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "project": {
          "description": "The Slug of the Project to act on; defaults to the Project containing your working directory",
          "type": "string"
        },
        "ref": {
          "description": "The Issue: #N, N, slug#N or its URL",
          "type": "string"
        },
        "session": {
          "description": "Your Session id, for direct-HTTP clients; the X-Loom-Session header wins",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "blocked_by"
      ],
      "type": "object"
    },
    "name": "add_blockers",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "blocked_by": {
          "description": "All of the Issue's Blockers after the change",
