[
  {
    "description": "Append text to the end of the section under a Markdown heading in an Issue's body. Needs no version, so concurrent sessions can all append safely.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "heading": {
          "description": "The section's heading text, e.g. Decisions so far",
          "type": "string"
        },
        "project": {
          "description": "The Slug of the Project to act on; defaults to the Project containing your working directory",
          "type": "string"
        },
        "ref": {
          "description": "The Issue: #N, N, slug#N or its URL",
          "type": "string"
        },
        "session": {
          "description": "Your Session id, for direct-HTTP clients; the X-Loom-Session header wins",
          "type": "string"
        },
        "text": {
          "description": "Markdown to add as the section's last lines",
          "type": "string"
        }
      },
      "required": [
        "ref",
        "heading",
        "text"
      ],
      "type": "object"
    },
    "name": "append_to_section",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "ref": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        }
      },
      "required": [
        "ref",
        "version"
      ],
      "type": "object"
    }
  },
